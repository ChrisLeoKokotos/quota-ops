{
  "name": "quota-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server/dashboard-server.ts",
    "build": "next build",
    "start": "node --experimental-strip-types server/dashboard-server.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 --experimental-strip-types tests/*.test.ts",
    "collector:setup": "node --experimental-strip-types collector/cli.ts",
    "collector:start": "node --experimental-strip-types collector/service.ts",
    "desktop:installer:win": "node desktop/build-installer.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.0",
    "typescript": "6.0.2"
  }
}
